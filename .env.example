# ============================================================
# LLM Configuration — EXAMPLE ONLY
# Copy to `.env` and fill in YOUR OWN DeepSeek API Key.
# The API Key is read at runtime only; it is NOT committed to any file.
# ============================================================

LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-flash
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
